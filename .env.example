# Copy to .env and set paths for this machine.
# Relative paths are resolved from the project root.
AIIJC_DATA_PATH=./data
AIIJC_RUNS_PATH=./runs

# Optional: Telegram notifications after every epoch and at the end of a run.
# Both must be set or notifications stay off; training never depends on them.
# The token belongs in .env (gitignored) and nowhere else — never in a config,
# a notebook cell or a commit.
# TELEGRAM_BOT_TOKEN=123456:AA...
# TELEGRAM_CHAT_ID=123456789
