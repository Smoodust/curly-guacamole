# Copy to .env and set paths for this machine.
# Relative paths are resolved from the project root.
AIIJC_DATA_PATH=./data
AIIJC_RUNS_PATH=./runs

# Optional hardware overrides. Uncomment for this machine.
# Process environment > .env > experiment YAML. Empty values use YAML.
# AIIJC_BATCH_SIZE=4
# AIIJC_ACCUM_STEPS=4
# AIIJC_AMP=bf16
# AIIJC_DEVICE=cuda
# AIIJC_DEVICES=auto
# Or select GPUs explicitly: AIIJC_DEVICES="[0, 1]"
# AIIJC_DISTRIBUTED_BACKEND=auto
# AIIJC_WORKERS=10
